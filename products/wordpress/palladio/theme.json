	"styles": {
		"color": {
			"background": "var(--wp--preset--color--calce)",
			"text": "var(--wp--preset--color--inchiostro)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--eb-garamond)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.5",
			"fontWeight": "400"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--30)",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.229",
					"letterSpacing": "-0.01em",
					"fontWeight": "400"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.297",
					"letterSpacing": "-0.005em",
					"fontWeight": "400"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.386",
					"letterSpacing": "0",
					"fontWeight": "400"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.5",
					"letterSpacing": "0",
					"fontWeight": "400",
					"fontStyle": "italic"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.5",
					"letterSpacing": "0",
					"fontWeight": "400",
					"fontStyle": "italic"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.5",
					"letterSpacing": "0.08em",
					"fontWeight": "400",
					"textTransform": "uppercase"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--eb-garamond)",
					"fontWeight": "400"
				},
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--50)",
						"bottom": "var(--wp--preset--spacing--20)"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--inchiostro)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--pietra)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--inchiostro)",
						"offset": "0.2em",
						"style": "solid",
						"width": "1px"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--inchiostro)",
					"text": "var(--wp--preset--color--calce)"
				},
				"border": {
					"radius": "0",
					"width": "0"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--eb-garamond)",
					"fontSize": "var(--wp--preset--font-size--medium)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--20)",
						"bottom": "var(--wp--preset--spacing--20)",
						"left": "var(--wp--preset--spacing--40)",
						"right": "var(--wp--preset--spacing--40)"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--pietra)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--pietra)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "italic"
				}
			},
			"cite": {
				"typography": {
					"fontStyle": "italic"
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--linea)"
				},
				"border": {
					"width": "1px 0 0 0",
					"style": "solid"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"width": "1px",
						"style": "solid",
						"color": "var(--wp--preset--color--linea)"
					}
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--40)"
					}
				},
				"typography": {
					"fontStyle": "italic"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontStyle": "italic"
				},
				"border": {
					"width": "0"
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"letterSpacing": "0.04em",
					"textTransform": "uppercase"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				},
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--20)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--pietra)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/image": {
				"border": {
					"radius": "0"
				}
			},
			"core/code": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"border": {
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--linea)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--20)",
						"bottom": "var(--wp--preset--spacing--20)",
						"left": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--30)"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Kopf",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Fuß",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-mitte",
			"title": "Seite mit Mitte (ohne Titelzeile)",
			"postTypes": [
				"page"
			]
		}
	]
}
