				},
				{
					"slug": "30",
					"name": "1 Modul",
					"size": "clamp(1.5938rem, 1.5226rem + 0.3233vw, 1.7812rem)"
				},
				{
					"slug": "40",
					"name": "1½ Moduln",
					"size": "clamp(2.3906rem, 2.2839rem + 0.4849vw, 2.6719rem)"
				},
				{
					"slug": "50",
					"name": "2 Moduln",
					"size": "clamp(3.1875rem, 3.0453rem + 0.6466vw, 3.5625rem)"
