				{
					"slug": "small",
					"name": "Klein",
					"size": "clamp(0.7969rem, 0.7613rem + 0.1616vw, 0.8906rem)"
				},
				{
					"slug": "medium",
					"name": "Text",
					"size": "clamp(1.0625rem, 1.0151rem + 0.2155vw, 1.1875rem)"
				},
				{
					"slug": "large",
					"name": "Groß",
					"size": "clamp(1.4167rem, 1.2784rem + 0.6286vw, 1.7812rem)"
				},
				{
					"slug": "x-large",
					"name": "Sehr groß",
					"size": "clamp(1.8889rem, 1.5919rem + 1.35vw, 2.6719rem)"
				},
				{
					"slug": "xx-large",
					"name": "Titel",
					"size": "clamp(2.5185rem, 1.9536rem + 2.5677vw, 4.0078rem)"
				},
				{
					"slug": "huge",
					"name": "Eingang",
					"size": "clamp(3.358rem, 2.3515rem + 4.5753vw, 6.0117rem)"
				}
			]
		},
		"custom": {
			"palladio": {
				"modulo": "clamp(1.5938rem, 1.5226rem + 0.3233vw, 1.7812rem)",
				"minuto": "calc(clamp(1.5938rem, 1.5226rem + 0.3233vw, 1.7812rem) / 60)",
				"abschnitt": "var(--wp--preset--spacing--60)",
				"ziel": "2.75rem"
			}
		}
